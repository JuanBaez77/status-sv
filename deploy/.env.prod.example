# Se copia a deploy/.env EN EL SERVIDOR y se completa ahí. Nunca se commitea.
#
#   cp deploy/.env.prod.example deploy/.env
#   chmod 600 deploy/.env

# Dominio del control plane. Tiene que apuntar a este servidor antes de levantar
# Caddy, porque el certificado se pide al arrancar.
STATUSSV_DOMAIN=status.ejemplo.com

# Contraseña de PostgreSQL. Generarla en el servidor, nunca inventarla a mano:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Versión que se despliega: la escribe el runbook a partir del commit.
STATUSSV_VERSION=dev
STATUSSV_COMMIT=unknown

STATUSSV_LOG_LEVEL=info

# Puerto en 127.0.0.1 donde queda el control plane para el nginx del host.
# Solo importa sin el perfil "caddy". Elegir uno libre: ss -tln
STATUSSV_LOCAL_PORT=8090

# --- Backup (docs/runbook-despliegue.md, "Backup y restore") ---
#
# Con "backup" en COMPOSE_PROFILES, "up -d" levanta también la copia diaria.
# Dejarlo vacío hasta tener el almacenamiento y la contraseña listos.
COMPOSE_PROFILES=

# El repositorio de restic. En Cloudflare R2:
#   s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/status-sv
STATUSSV_BACKUP_REPOSITORY=
# El token de API de R2, con permiso de lectura y escritura solo en ese bucket.
STATUSSV_BACKUP_KEY_ID=
STATUSSV_BACKUP_SECRET=
# La hora UTC de la copia diaria (06 = las 3 de la mañana en Buenos Aires).
STATUSSV_BACKUP_HORA_UTC=06
# Opcional: una URL de healthchecks.io (o parecido) que avisa si un día no hay copia.
STATUSSV_BACKUP_PING_URL=
