# Caddy termina TLS y le pasa el tráfico al control plane por la red interna.
#
# El certificado lo pide solo a Let's Encrypt la primera vez que arranca, así
# que el dominio tiene que apuntar a este servidor y los puertos 80 y 443 tienen
# que estar abiertos antes de levantarlo. Con Cloudflare adelante, el primer
# certificado sale con el proxy apagado (ver docs/runbook-despliegue.md).

{
	servers {
		# IP real del cliente detrás de Cloudflare: CF-Connecting-IP se cree
		# solo si la conexión viene de uno de estos rangos. Son los oficiales
		# (https://www.cloudflare.com/ips-v4 y /ips-v6), los mismos de
		# deploy/nginx/statussv-cloudflare-realip.conf; si cambian, cambian
		# en los dos lados. Sin Cloudflare adelante, no hacen nada.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$STATUSSV_DOMAIN} {
	# El panel viaja sin comprimir desde el binario: lo comprime Caddy, como
	# lo hacía nginx.
	encode zstd gzip

	# El WebSocket de los agents pasa por acá sin configuración extra: Caddy
	# detecta el Upgrade y deja el canal abierto.
	reverse_proxy server:8080 {
		# Un solo valor, el cliente real: el control plane toma el primero de
		# la lista, y lo que venga del cliente o de Cloudflare no se reenvía.
		header_up X-Forwarded-For {client_ip}
	}

	header {
		# Solo HTTPS de acá en adelante, para el dominio y sus subdominios.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# No anunciar qué software atiende.
		-Server
	}

	log {
		output stdout
		format json
	}
}
