# status-sv: configuración provisoria, solo para obtener el primer certificado.
#
# Mientras no existe el certificado no se puede declarar el bloque HTTPS, así
# que este archivo atiende únicamente el desafío de Let's Encrypt en el puerto 80.
# Una vez emitido el certificado, se reemplaza por status-sv.conf.template.
#
# Generado por deploy/nginx/render.sh. No editar a mano en el servidor.

server {
    listen 80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 404;
    }
}
