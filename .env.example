# Copiar a .env y ajustar. El archivo .env nunca se commitea.

# --- PostgreSQL de desarrollo (deploy/docker-compose.dev.yml) ---
POSTGRES_USER=statussv
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=statussv
POSTGRES_PORT=5433

# --- Cadena de conexión que usan el control plane y las migraciones ---
# sslmode=disable es válido solo acá, contra la base local que escucha en 127.0.0.1.
# En el VPS la base va por red interna de Docker y con TLS si sale del host.
DATABASE_URL=postgres://statussv:cambiar-en-local@127.0.0.1:5433/statussv?sslmode=disable

# --- Tests de integración ---
# Si está vacía, los tests con la etiqueta `integration` se saltean.
TEST_DATABASE_URL=postgres://statussv:cambiar-en-local@127.0.0.1:5433/statussv_test?sslmode=disable

# --- Control plane ---
# Dónde escucha la API. En producción va detrás de Caddy, así que escucha solo en localhost.
STATUSSV_LISTEN_ADDR=127.0.0.1:8080
# Cuánto vive un token de enrolamiento (entre 1m y 1h).
STATUSSV_ENROLLMENT_TTL=15m
# Silencio tras el cual un servidor se considera caído (entre 10s y 10m).
STATUSSV_OFFLINE_AFTER=45s
# debug, info, warn o error.
STATUSSV_LOG_LEVEL=info
# json para el VPS, text para desarrollo.
STATUSSV_LOG_FORMAT=json
# Archivo con la clave que cifra los secretos TOTP del panel (ADR-013). Obligatorio.
# Se genera una vez con: openssl rand -base64 32 > deploy/secrets/totp.key
# Si se pierde, todos los usuarios tienen que hacer `server user-totp-reset`.
STATUSSV_TOTP_KEY_FILE=deploy/secrets/totp.key
