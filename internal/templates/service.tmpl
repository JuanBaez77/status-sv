# Unidad del proyecto {{.Project}}, generada por status-sv (ADR-023).
#
# La escribió `statussv-agent project accept`. No se edita a mano: se cambia la
# plantilla (en el repo de status-sv, o como root en
# /etc/status-sv/templates/service.tmpl) y se genera de nuevo.

[Unit]
Description={{.Project}} (status-sv)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.User}}
WorkingDirectory={{.Workdir}}
{{- if .EnvFile}}
EnvironmentFile={{.EnvFile}}
{{- end}}
ExecStart={{.ExecStart}}
Restart=on-failure
RestartSec=5

# El proyecto escribe donde le dejan los permisos de su usuario (su workdir);
# el sistema y /tmp de los demás, no.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
