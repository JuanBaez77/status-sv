# Sitio del proyecto {{.Project}}, generado por status-sv (ADR-023).
#
# Lo escribió `statussv-agent project accept` (o `project site`). No se edita a
# mano: se cambia la plantilla (en el repo de status-sv, o como root en
# /etc/status-sv/templates/nginx-site.tmpl) y se genera de nuevo.
{{- if .TLS}}

map $http_upgrade ${{.UpgradeVar}} {
    default upgrade;
    ''      close;
}
{{- end}}

server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}};

    # El desafío de Let's Encrypt, para pedir y renovar el certificado.
    location ^~ /.well-known/acme-challenge/ {
        root {{.ACMERoot}};
        default_type text/plain;
    }

    location / {
{{- if .TLS}}
        return 301 https://$host$request_uri;
{{- else}}
        # Todavía no hay certificado.
        return 404;
{{- end}}
    }
}
{{- if .TLS}}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{.Domain}};

    ssl_certificate {{.CertDir}}/fullchain.pem;
    ssl_certificate_key {{.CertDir}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:{{.Port}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection ${{.UpgradeVar}};
        proxy_read_timeout 60s;
    }
}
{{- end}}
