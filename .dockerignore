# Todo lo que no hace falta para compilar: acelera el build y evita mandar
# secretos al contexto de Docker.
.git/
.github/
.env
.env.*
!.env.example
# Los secretos del control plane viven en deploy/ del servidor: el build corre en
# /opt/status-sv y no los necesita.
deploy/.env
deploy/secrets/
bin/
web/node_modules/
web/dist/
docs/
*.md
!README.md

# El panel embebido lo compila la etapa de Node adentro de la imagen: lo que
# haya quedado de un build local no entra, así no se cuelan archivos viejos.
server/internal/panel/dist/*
!server/internal/panel/dist/sin-panel.html
